---
layout: layouts/base.njk
title: WRONGORIGIN
meta-description: WRONGORIGIN — Photography portfolio
---

<section class="hero">
  <div class="hero__bg"></div>
  <div class="hero__content">
    <p class="hero__eyebrow">wrongorigin.</p>

    <div class="hero__video-wrap">
<video
  class="hero__video"
  src="{{ '/images/logospin.mp4' | url }}"
  autoplay
  loop
  muted
  playsinline
  preload="auto"
></video>
    </div>

    <p class="hero__sub">Bleed your visuals into reality.</p>
    <a href="{{ '/projects/' | url }}" class="hero__cta"><span>View Work</span></a>
  </div>
  <div class="hero__scroll-hint">
    <span>Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<section class="series">
  <div class="series__header">
    <h2 class="series__heading">Selected Series</h2>
    <a href="{{ '/projects/' | url }}" class="series__all">All work →</a>
  </div>

  <div class="series__grid">
    {% for project in collections.projects | slice(0, 4) %}
      <a class="series__item" href="{{ project.url | url }}" style="--i: {{ loop.index }}">
        <div class="series__img-wrap">
          {% if project.data.cover %}
            <img class="series__img" src="{{ project.data.cover | url }}" alt="{{ project.data.title }}" loading="lazy" />
          {% else %}
            <img class="series__img" src="{{ '/images/wrongorigintransparent.png' | url }}" alt="{{ project.data.title }}" loading="lazy" />
          {% endif %}
          <div class="series__overlay"></div>
        </div>
        <div class="series__meta">
          <span class="series__num">{{ loop.index | padStart(2, '0') }}</span>
          <span class="series__title">{{ project.data.title }}</span>
          <span class="series__location">{{ project.data.location }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

<section class="statement">
  <div class="statement__inner">
    <p class="statement__text">
      Scenes and stills taken from beyond your front door<br/>
      <em>frames from edges of the world you have yet to explore</em> wrongorigin.
    </p>
  </div>
</section>
