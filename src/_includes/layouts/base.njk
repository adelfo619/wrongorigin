<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ meta-description or 'WRONGORIGIN — Photography portfolio' }}" />
  <title>{{ title or 'WRONGORIGIN' }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;1,300;1,400&family=Syne:wght@400;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}" />
</head>
<body>

  <nav class="nav">
    <a class="nav__logo" href="{{ '/' | url }}">
      <img class="nav__logo-img" src="{{ '/images/wrongorigintransparent.png' | url }}" alt="WRONGORIGIN" />
    </a>
    <ul class="nav__links">
      <li><a class="nav__link" href="{{ '/projects/' | url }}">Work</a></li>
      <li><a class="nav__link" href="{{ '/about/' | url }}">About</a></li>
    </ul>
  </nav>

  <main>
    {{ content | safe }}
  </main>

  <footer class="footer">
    <span class="footer__copy">© 2025 WRONGORIGIN. All rights reserved.</span>
    <span class="footer__tagline">Images made in the dark.</span>
  </footer>

  <script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>
