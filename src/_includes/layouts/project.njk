---
layout: layouts/base.njk
---

<article class="project">

  <header class="project__header">
    <a href="{{ '/projects/' | url }}" class="project__back">← All work</a>
    <h1 class="project__title">{{ title }}</h1>
    <div class="project__details">
      <span>{{ location }}</span>
      <span>{{ year }}</span>
    </div>
  </header>

  {% if cover %}
    <div class="project__hero">
      <img class="project__hero-img" src="{{ cover | url }}" alt="{{ title }}" />
    </div>
  {% endif %}

  {% if content %}
    <div class="project__body">
      <p class="project__statement">{{ content | safe }}</p>
    </div>
  {% endif %}

  {% if images and images.length %}
    <div class="project__gallery">
      {% for image in images %}
        <figure class="project__figure" style="--i: {{ loop.index }}">
          <img
            class="project__photo"
            src="{{ image.src | url }}"
            alt="{{ image.alt }}"
            loading="lazy"
          />
          {% if image.caption %}
            <figcaption class="project__caption">{{ image.caption }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  {% endif %}

  <nav class="project__nav">
    <a href="{{ '/projects/' | url }}" class="project__prev">← All work</a>
  </nav>

</article>
